[Unit]
Description=WireGuard transport (wstunnel client, TLS WebSocket over TCP 443)
After=network-online.target
Wants=network-online.target
Before=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wstunnel client --socket-so-mark 51820 -L "udp://127.0.0.1:51820:127.0.0.1:51820?timeout_sec=0" wss://<VPS_IP>:443
Restart=always
RestartSec=3
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
